import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { renderWithUi } from '@template/ui/testing/TestRendering';
import { fireEvent, screen, waitFor } from '@testing-library/react';
import { describe, expect, it } from 'vitest';

import type { ApiFailure } from '@/entities/apiFailure';
import type { Result } from '@/entities/result';

import { type {{dataTypeName}}, {{queryOptionsName}} } from '@/api/{{concept}}/queries';
import { {{componentName}} } from '{{{componentImportPath}}}';

const renderScreen = (queryClient: QueryClient): void => {
  renderWithUi(
    <QueryClientProvider client={queryClient}>
      <{{componentName}}{{#if hasParameters}} parameters={ {{{sampleParametersCode}}} }{{/if}} />
    </QueryClientProvider>,
  );
};

// 取得を止めた QueryClient に結果を入れておき、API を呼ばずに各状態を描く
const createSettledQueryClient = (result: Result<{{{valueTypeCode}}}, ApiFailure>): QueryClient => {
  const queryClient = new QueryClient({ defaultOptions: { queries: { enabled: false } } });
  queryClient.setQueryData({{{sampleOptionsCode}}}.queryKey, result);
  return queryClient;
};

describe('{{componentName}}', () => {
  it('queryFnが失敗のResultを返してもう一度読み込むボタンを押した場合、queryFnをもう一度呼ぶこと', async () => {
    const queryClient = new QueryClient();
    renderScreen(queryClient);

    fireEvent.click(await screen.findByRole('button', { name: 'もう一度読み込む' }));

    const expected = 2;
    await waitFor(() => {
      const actual = queryClient.getQueryState({{{sampleOptionsCode}}}.queryKey)?.dataUpdateCount;
      expect(actual).toBe(expected);
    });
  });

  it('queryのdataが成功のResultの場合、読み込んだ値を表示すること', () => {
    renderScreen(createSettledQueryClient({ ok: true, value: {{{idealValueCode}}} }));

{{#if hasRowsSelectedStory}}
    const actual = screen.getByRole('cell', { name: '見本' });
{{else}}
    const actual = screen.getByText('見本');
{{/if}}

    expect(actual).toBeInTheDocument();
  });
{{#if hasEmptyStory}}

  it('queryのdataが空の配列のResultの場合、まだないことを表示すること', () => {
    renderScreen(createSettledQueryClient({ ok: true, value: [] }));

    const actual = screen.getByText('{{concept}} はまだありません');

    expect(actual).toBeInTheDocument();
  });
{{/if}}
{{#if hasRowsSelectedStory}}

  it('行の選択のチェックボックスを押した場合、その行を選んだ状態にすること', () => {
    renderScreen(createSettledQueryClient({ ok: true, value: {{{idealValueCode}}} }));
    const checkbox = screen.getByRole('checkbox', { name: '{{concept}}見本を選択' });

    fireEvent.click(checkbox);

    expect(checkbox).toBeChecked();
  });
{{/if}}
{{#if hasNotFoundStory}}

  it('queryのdataがnot-foundの失敗のResultの場合、見つからないことを表示すること', () => {
    renderScreen(
      createSettledQueryClient({
        error: { kind: 'not-found', message: '見つかりません' },
        ok: false,
      }),
    );

    const actual = screen.getByText('{{concept}} が見つかりません');

    expect(actual).toBeInTheDocument();
  });
{{/if}}
});
