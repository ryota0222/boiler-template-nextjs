// エンドポイントをつなぐまでは、画面が送信の失敗を出すよう、つながっていないことを失敗として返す。
// つなぐときは mutationFn で requestEndpoint に src/api/{{concept}}/endpoints.ts の定義を渡す
{{#if hasParameters}}
export const {{mutationOptionsName}} = (
  parameters: {{{parametersTypeCode}}},
): ReturnType<
  typeof mutationOptions<Result<null, ApiFailure>, Error, {{dataTypeName}}, unknown>
> =>
  mutationOptions({
    mutationFn: (_values: {{dataTypeName}}): Promise<Result<null, ApiFailure>> =>
      Promise.resolve({
        error: { kind: 'internal', message: 'この画面の API はまだつながっていません' },
        ok: false,
      }),
    mutationKey: ['{{concept}}', '{{kind}}', parameters] as const,
  });
{{else}}
export const {{mutationOptionsName}} = mutationOptions({
  mutationFn: (_values: {{dataTypeName}}): Promise<Result<null, ApiFailure>> =>
    Promise.resolve({
      error: { kind: 'internal', message: 'この画面の API はまだつながっていません' },
      ok: false,
    }),
  mutationKey: ['{{concept}}', '{{kind}}'] as const,
});
{{/if}}
