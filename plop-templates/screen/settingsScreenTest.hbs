import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { renderWithUi } from '@template/ui/testing/TestRendering';
import { fireEvent, screen, waitFor } from '@testing-library/react';
import { describe, expect, it } from 'vitest';

import type { ApiFailure } from '@/entities/apiFailure';
import type { Result } from '@/entities/result';

import { type {{queryDataTypeName}}, {{queryOptionsName}} } from '@/api/{{concept}}/queries';
import { {{componentName}} } from '{{{componentImportPath}}}';

const settings: {{queryDataTypeName}} = { isNotified: true, name: '見本' };

const renderScreen = (queryClient: QueryClient): void => {
  renderWithUi(
    <QueryClientProvider client={queryClient}>
      <{{componentName}}{{#if hasParameters}} parameters={ {{{sampleParametersCode}}} }{{/if}} />
    </QueryClientProvider>,
  );
};

// 取得を止めた QueryClient に結果を入れておき、API を呼ばずに各状態を描く
const createSettledQueryClient = (result: Result<{{{queryValueTypeCode}}}, ApiFailure>): QueryClient => {
  const queryClient = new QueryClient({ defaultOptions: { queries: { enabled: false } } });
  queryClient.setQueryData({{{sampleQueryOptionsCode}}}.queryKey, result);
  return queryClient;
};

describe('{{componentName}}', () => {
  it('queryFnが失敗のResultを返してもう一度読み込むボタンを押した場合、queryFnをもう一度呼ぶこと', async () => {
    const queryClient = new QueryClient();
    renderScreen(queryClient);

    fireEvent.click(await screen.findByRole('button', { name: 'もう一度読み込む' }));

    const expected = 2;
    await waitFor(() => {
      const actual = queryClient.getQueryState({{{sampleQueryOptionsCode}}}.queryKey)?.dataUpdateCount;
      expect(actual).toBe(expected);
    });
  });

  it('queryのdataがまだない場合、読み込み中であることを表示すること', () => {
    renderScreen(new QueryClient({ defaultOptions: { queries: { enabled: false } } }));

    const actual = screen.getByRole('status', { name: '{{concept}} の設定を読み込み中' });

    expect(actual).toBeInTheDocument();
  });

  it('queryのdataが成功のResultの場合、読み込んだ値を表示すること', () => {
    renderScreen(createSettledQueryClient({ ok: true, value: settings }));

    const actual = screen.getByText('見本');

    expect(actual).toBeInTheDocument();
  });

  it('名前を直して保存し、mutationFnが失敗のResultを返した場合、保存できなかったことを表示すること', async () => {
    renderScreen(createSettledQueryClient({ ok: true, value: settings }));
    fireEvent.click(screen.getByRole('button', { name: '直す' }));

    fireEvent.click(screen.getByRole('button', { name: '保存する' }));

    const actual = await screen.findByRole('textbox', { name: '名前' });
    await waitFor(() => {
      expect(actual).toHaveAttribute('aria-invalid', 'true');
    });
  });

  it('お知らせを切り替えてmutationFnが失敗のResultを返した場合、保存できなかったことを表示すること', async () => {
    renderScreen(createSettledQueryClient({ ok: true, value: settings }));

    fireEvent.click(screen.getByRole('checkbox', { name: '{{concept}} が変わったときにメールで知らせる' }));

    const actual = await screen.findByText(
      '保存できませんでした。時間をおいてから、もう一度保存してください。',
    );
    expect(actual).toBeInTheDocument();
  });

  it('削除するボタンを押した場合、削除を確かめるダイアログを開くこと', async () => {
    renderScreen(createSettledQueryClient({ ok: true, value: settings }));

    fireEvent.click(screen.getByRole('button', { name: '{{concept}} を削除する' }));

    const actual = await screen.findByRole('dialog');
    expect(actual).toBeInTheDocument();
  });
});
