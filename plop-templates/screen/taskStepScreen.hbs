'use client';

import type { ResultCardStatus } from '@template/ui/blocks/result-card/ResultCard';

import { Button, Stack, Text, TextInput } from '@mantine/core';
import { useNetwork } from '@mantine/hooks';
import { useMutation } from '@tanstack/react-query';
import { HandheldLayout } from '@template/ui/blocks/handheld-layout/HandheldLayout';
import { MetricValue } from '@template/ui/blocks/metric-value/MetricValue';
import { ResultCard } from '@template/ui/blocks/result-card/ResultCard';
import { useRef, useState } from 'react';

import type { ApiFailure } from '@/entities/apiFailure';
import type { Result } from '@/entities/result';

import { type {{mutationResultTypeName}}, {{mutationOptionsName}} } from '@/api/{{concept}}/mutations';

const offlineLabels = {
  description: 'つながるまで記録しません',
  title: '通信が切れています',
};

const toResultCardStatus = ({
  isOnline,
  isPending,
  result,
}: {
  readonly isOnline: boolean;
  readonly isPending: boolean;
  readonly result: null | Result<{{mutationResultTypeName}}, ApiFailure>;
}): ResultCardStatus => {
  // 通信が切れている間は TanStack Query が送らずに待つため、確かめている途中とは見せず、まだ記録していないことを出す
  if (!isOnline && isPending) {
    return {
      detail: 'つながったら確かめます。まだ記録していません',
      kind: 'offline',
      label: '通信が切れています',
    };
  }

  if (isPending || result === null) {
    return { kind: 'pending', label: '確かめています…' };
  }

  if (!result.ok) {
    return {
      detail: '時間をおいてから、もう一度バーコードを読んでください',
      kind: 'failure',
      label: '確かめられませんでした',
    };
  }

  return result.value.isMatched
    ? { kind: 'success', label: '合っています' }
    : {
        detail: `読んだのは ${result.value.name} です。入れる {{concept}} のバーコードを読み直してください`,
        kind: 'failure',
        label: '違う {{concept}} です',
      };
};

{{#if hasParameters}}
export const {{componentName}} = ({
  parameters,
}: {
  readonly parameters: {{{parametersTypeCode}}};
}): React.JSX.Element => {
{{else}}
export const {{componentName}} = (): React.JSX.Element => {
{{/if}}
  const mutation = useMutation({{{mutationOptionsCode}}});
  const { online } = useNetwork();
  const [code, setCode] = useState('');
  const inputReference = useRef<HTMLInputElement>(null);
  // 読んだバーコードは応答を待たずにすぐ出し、確かめた結果だけを帯で待つ（design-feedback.md）
  const scannedCode = mutation.variables?.code ?? null;
  // 結果が出たら次へ進める。違う物を読んだときに進ませないかは、業務の決まりに合わせて変える
  const isNextEnabled = scannedCode !== null && !mutation.isPending;

  const submitCode = (): void => {
    const trimmedCode = code.trim();
    if (trimmedCode === '') {
      return;
    }

    mutation.mutate({ code: trimmedCode });
    setCode('');
  };

  return (
    <HandheldLayout
      // 親指の届く下の端に、押すボタンを 1 つだけ置く（design-recipes.md）
      footer={
        <Button
          disabled={!isNextEnabled}
          fullWidth
          onClick={() => {
            mutation.reset();
            inputReference.current?.focus();
          }}
          size="lg"
        >
          次の {{concept}} へ
        </Button>
      }
      menu={null}
      offlineLabels={offlineLabels}
      progress={null}
      title="{{heading}}"
    >
      <Stack gap="md">
        {/* バーコードのリーダーは読んだ文字の後に Enter を送るため、form の送信で確かめる */}
        <form
          onSubmit={(event) => {
            event.preventDefault();
            submitCode();
          }}
        >
          <TextInput
            description="読むと、入れる {{concept}} かを確かめます"
            label="{{concept}} のバーコード"
            onChange={(event) => {
              setCode(event.currentTarget.value);
            }}
            ref={inputReference}
            value={code}
          />
        </form>
        {scannedCode === null ? null : (
          <ResultCard
            status={toResultCardStatus({
              isOnline: online,
              isPending: mutation.isPending,
              result: mutation.data ?? null,
            })}
          >
            <Stack gap={4}>
              <Text c="dimmed" size="xs">
                読んだバーコード
              </Text>
              <MetricValue size="xl" unit={null} value={scannedCode} />
            </Stack>
          </ResultCard>
        )}
      </Stack>
    </HandheldLayout>
  );
};
