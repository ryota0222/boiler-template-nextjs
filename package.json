{
  "name": "nextjs-template",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "lefthook install",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "playwright install chromium && prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ .storybook/ packages/ plopfile.ts generators/",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --project unit --project storybook",
    "test:db": "vitest run --project db",
    "test:generators": "vitest run --project generators",
    "test:watch": "vitest --project unit --project storybook",
    "test:coverage": "vitest run --project unit --project storybook --coverage",
    "knip": "knip",
    "depcruise": "depcruise src/ packages/",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:text": "textlint \"src/**/*.tsx\"",
    "lint:text:fix": "textlint --fix \"src/**/*.tsx\"",
    "lint:actions": "mise exec -- actionlint",
    "scan:secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "scan:gitleaks": "mise exec -- gitleaks git --redact --no-banner",
    "lint:sh": "git ls-files --cached --others --exclude-standard '*.sh' | xargs mise exec -- shellcheck",
    "format:sh": "git ls-files --cached --others --exclude-standard '*.sh' | xargs mise exec -- shfmt -i 2 -ci -bn -sr -d",
    "format:sh:fix": "git ls-files --cached --others --exclude-standard '*.sh' | xargs mise exec -- shfmt -i 2 -ci -bn -sr -w",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "generate": "plop --plopfile plopfile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "postcss@<8.5.10": ">=8.5.10",
      "smol-toml@<1.6.1": ">=1.6.1",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1"
    }
  },
  "dependencies": {
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/notifications": "9.6.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.101.4",
    "@template/ui": "workspace:*",
    "next": "16.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remeda": "^2.39.0",
    "thinking-orbs": "0.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@chromatic-com/storybook": "^5.4.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-unicorn": "^72.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "node-plop": "0.32.3",
    "plop": "4.0.5",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "secretlint": "^13.0.4",
    "storybook": "^10.6.1",
    "textlint": "^15.7.1",
    "textlint-plugin-jsx": "^1.3.0",
    "textlint-rule-prh": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  },
  "knip": {
    "ignoreBinaries": [
      "mise"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "src/shared-components/**/*.{ts,tsx}",
          "src/features/**/*.{ts,tsx}",
          "src/helpers/**/*.{ts,tsx}",
          "src/gateways/**/*.ts",
          "src/entities/**/*.ts",
          "prisma/seed.ts"
        ],
        "ignore": [
          "prisma/generated/**"
        ],
        "ignoreDependencies": [
          "@commitlint/cli",
          "@commitlint/config-conventional",
          "@testing-library/jest-dom",
          "@testing-library/react",
          "@secretlint/secretlint-rule-preset-recommend",
          "textlint-plugin-jsx",
          "textlint-rule-prh",
          "zustand",
          "@prisma/client"
        ],
        "next": {
          "entry": [
            "src/app/**/{layout,page,loading,error,not-found,template,default}.{ts,tsx}",
            "next.config.ts"
          ]
        }
      },
      "packages/ui": {}
    }
  }
}
