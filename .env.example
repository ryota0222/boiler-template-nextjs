# アプリが接続するDB
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# DB統合テストが接続するDB（pnpm test:db が使用）
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/app_test

# compose.yaml が参照する
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# メンテナンスモード（src/proxy.ts）。true にすると全画面をお知らせに差し替え、API は 503 を返す
MAINTENANCE_MODE=false
# 再開の予定（ISO 8601。例: 2026-11-10T06:00:00+09:00）。空なら出さない
MAINTENANCE_UNTIL=
# メンテナンス中に確かめる人だけが通るためのトークン。?maintenance_bypass=<トークン> で開く。空なら誰も通さない
MAINTENANCE_BYPASS_TOKEN=
