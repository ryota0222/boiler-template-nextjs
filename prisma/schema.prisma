datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../prisma/generated"
  importFileExtension = ""
}

model Todo {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}
